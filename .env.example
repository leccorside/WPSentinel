# Sites monitorados: prefixos separados por vírgula. Cada prefixo listado aqui precisa,
# no mínimo, de <PREFIXO>_URL e <PREFIXO>_REMOTE_ROOT. Para incluir um site, crie o bloco
# dele abaixo e acrescente o prefixo nesta lista; para retirar, basta tirá-lo da lista.
SITES=MEUSITE

# SFTP padrão, usado por todos os sites que não tiverem <PREFIXO>_SFTP_* próprio.
# Use preferencialmente uma conta somente-leitura para o monitor.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# Frequência do monitor. A verificação completa de hashes acontece a cada FULL_HASH_EVERY ciclos.
INTERVAL_SECONDS=300
FULL_HASH_EVERY=24
MAX_DOWNLOAD_BYTES=8388608

# IPs extras do servidor de hospedagem, separados por vírgula (opcional).
# Sessões de login vindas desses IPs geram alerta crítico. O monitor já inclui
# os IPs do domínio de cada site, do SFTP e do banco.
SERVER_IPS=

# ---------------------------------------------------------------------------
# Exemplo de site (prefixo MEUSITE). Copie o bloco para cada site e troque o prefixo.
# ---------------------------------------------------------------------------
MEUSITE_NAME=Meu Site
MEUSITE_URL=https://meusite.com.br
# Pasta do WordPress no servidor (onde ficam wp-config.php, wp-admin e wp-content).
MEUSITE_REMOTE_ROOT=/home/usuario/public_html
# Identificador usado no histórico (.monitor-data). Opcional; padrão: prefixo em minúsculas.
# Não mude depois que o site já tiver histórico.
MEUSITE_KEY=meusite

# SFTP próprio do site (opcional; se vazio, usa o SFTP padrão acima).
MEUSITE_SFTP_HOST=
MEUSITE_SFTP_PORT=
MEUSITE_SFTP_USER=
MEUSITE_SFTP_PASSWORD=

# Banco de dados (opcional; deixe DB_HOST vazio para não verificar o banco).
# Na HostGator/cPanel, libere o IP de quem roda o monitor em "MySQL Remoto".
# Se a senha tiver $ ou #, coloque-a entre aspas simples.
MEUSITE_DB_HOST=
MEUSITE_DB_PORT=3306
MEUSITE_DB_NAME=
MEUSITE_DB_USER=
MEUSITE_DB_PASSWORD=
MEUSITE_DB_PREFIX=wp_
MEUSITE_DB_SSL=false

# Opcional, só para sites invadidos por spam: posts/páginas criados a partir destas datas
# (AAAA-MM-DD) são considerados spam e a limpeza propõe apagá-los. Confirme antes que não
# há conteúdo legítimo depois dessas datas.
MEUSITE_SPAM_SINCE_POST=
MEUSITE_SPAM_SINCE_PAGE=

{
  "name": "wp-sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agentless security monitor for WordPress sites: detects malware, hidden SEO spam and suspicious logins over SFTP and MySQL, with guided cleanup and daily reports.",
  "scripts": {
    "scan": "node src/monitor.mjs --once",
    "scan:full": "node src/monitor.mjs --once --full-hash",
    "monitor": "node src/monitor.mjs",
    "plan": "node src/clean.mjs --plan",
    "clean": "node src/clean.mjs",
    "reset-baseline": "node src/monitor.mjs --reset-baseline --once"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "mysql2": "3.24.4",
    "php-serialize": "^5.1.3",
    "ssh2-sftp-client": "12.1.1"
  }
}
